#include "../../../datalog_engines/minimal.dl"

Goal($Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q")))).

Line(1, $Conditional($Atom("Q"), $Conditional($Atom("Q"), $Atom("Q"))), "Simp", 0, 0).
Line(2, $Conditional($Atom("Q"), $Conditional($Conditional($Atom("Q"), $Atom("Q")), $Atom("Q"))), "Simp", 0, 0).
Line(3, $Conditional($Conditional($Atom("Q"), $Conditional($Conditional($Atom("Q"), $Atom("Q")), $Atom("Q"))), $Conditional($Conditional($Atom("Q"), $Conditional($Atom("Q"), $Atom("Q"))), $Conditional($Atom("Q"), $Atom("Q")))), "Frege", 0, 0).
Line(4, $Conditional($Conditional($Atom("Q"), $Conditional($Atom("Q"), $Atom("Q"))), $Conditional($Atom("Q"), $Atom("Q"))), "Modus Ponens", 2, 3).
Line(5, $Conditional($Atom("Q"), $Atom("Q")), "Modus Ponens", 1, 4).
Line(6, $Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q"))), "Or-IR", 0, 0).
Line(7, $Conditional($Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q"))), $Conditional($Atom("Q"), $Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q"))))), "Simp", 0, 0).
Line(8, $Conditional($Atom("Q"), $Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q")))), "Modus Ponens", 6, 7).
Line(9, $Conditional($Conditional($Atom("Q"), $Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q")))), $Conditional($Conditional($Atom("Q"), $Atom("Q")), $Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q"))))), "Frege", 0, 0).
Line(10, $Conditional($Conditional($Atom("Q"), $Atom("Q")), $Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q")))), "Modus Ponens", 8, 9).
Line(11, $Conditional($Atom("Q"), $Or($Atom("P"), $Atom("Q"))), "Modus Ponens", 5, 10).
