/* NOTE: THIS HAS THE ORIGINAL BY-HAND DATALOG FOR INTUITIONISTIC LOGIC. */
/* COMMENTS HERE APPLY TO THE OTHER FILES GENERATED BY THE SPEC COMPILER */

// we start with a set of sentences, and constructors for sentences. 
.type Sentence = Atom {name: symbol} | Bot {} | Impl {a: Sentence, b: Sentence}


// DEFAULT BLOCK
.type Goal = ToProve {s: Sentence} // proof object to relativize the steps and validity to
// A proof line: number, formula, justification, and line refs (for MP only)
.decl Line(line_num: unsigned, line_content: Sentence, line_just: symbol, i: unsigned, j: unsigned, goal: Goal)
.decl Justified(n: unsigned, goal: Goal)
.decl Unjustified(n: unsigned, goal: Goal)
.decl UnjustifiedCount(c: number, goal: Goal) // whats the diff bt unsigned and number
.decl Claim(goal: Goal)
.decl Proven(f: Sentence)

/* tell you where you went wrong in case of wrong proof */
Unjustified(n, goal) :- Line(n, _, _, _, _, goal), !Justified(n, goal).
UnjustifiedCount(c, goal) :- Claim(goal), c = count : { Unjustified(_, goal) }.

/* a claim is proven if it appears as a valid line and the whole proof checks out */
Proven(f) :- Claim($ToProve(f)), // it's something we set out to prove
            Line(n, f, _, _, _, $ToProve(f)), // what we want to prove is the last line of the proof
            Justified(n, $ToProve(f)), // that last line is justified
            UnjustifiedCount(0, $ToProve(f)). // there are no unjustified lines for that goal

.output Unjustified
.output Justified
.output Proven



// COMPILED BLOCK
Justified(n, goal) :- Line(n, $Impl(P, P), "Axiom1", _, _, goal).
Justified(n, goal) :- Line(n, 
                $Impl(P, $Impl(_, P)), 
                "Axiom2", _, _, goal).
Justified(n, goal) :- Line(n,
                $Impl($Impl(P, Q), $Impl($Impl(P, $Impl(Q, R)), $Impl(P, R))),
                "Axiom3", _, _, goal).
Justified(n, goal) :- Line(n, 
                $Impl($Impl(P, $Bot()), $Impl(P, _)), 
                "Axiom4", _, _, goal).


/* modus ponens: line i is P, line j is P -> Q, this line is Q */
Justified(n, goal) :- Line(n, Q, "MP", i, j, goal),
            i < n, j < n,
            Justified(i, goal), Justified(j, goal),
            Line(i, P, _, _, _, goal),
            Line(j, $Impl(P, Q), _, _, _, goal).



