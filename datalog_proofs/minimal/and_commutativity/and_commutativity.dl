Line(7, $Conditional($Conditional($And($Atom("A"), $Atom("B")), $Atom("B")), $Conditional($And($Atom("A"), $Atom("B")), $Conditional($Atom("A"), $And($Atom("B"), $Atom("A"))))), "Modus Ponens", 5, 6).
